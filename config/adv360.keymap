#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            display-name = "Base";
            bindings = <
&none       &none        &none       &none       &none        &none  &none                                               &mo 5      &none  &none        &none       &none       &none           &none
&none       &kp Q        &kp W       &kp E       &kp R        &kp T  &none                                               &none      &kp Y  &kp U        &kp I       &kp O       &kp P           &none
&kp ESCAPE  &hm LSHFT A  &hm LALT S  &hm LGUI D  &hm LCTRL F  &kp G  &none     &kp DELETE  &none      &kp CAPS  &none    &none      &kp H  &hm RCTRL J  &hm RGUI K  &hm RALT L  &hm RSHFT SEMI  &kp SINGLE_QUOTE
&none       &kp Z        &kp X       &kp C       &kp V        &kp B                        &none      &none                         &kp N  &kp M        &kp COMMA   &kp DOT     &kp FSLH        &none
&mo 3       &none        &none       &mo 2       &mo 1               &kp BSPC  &kp ENTER   &mo 4      &mo 4     &kp TAB  &kp SPACE         &mo 1        &none       &none       &none           &mo 3
            >;
        };

        Symbols {
            bindings = <
&trans     &trans           &trans       &trans                &trans            &trans         &trans                                      &trans  &trans            &trans             &trans                 &trans          &trans     &trans
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH              &kp DOLLAR        &kp PERCENT    &trans                                      &trans  &kp CARET         &kp AMPERSAND      &kp ASTERISK           &kp UNDERSCORE  &kp PLUS   &trans
&kp GRAVE  &kp PIPE         &kp COLON    &kp LEFT_PARENTHESIS  &kp LEFT_BRACE    &kp LESS_THAN  &trans  &trans  &trans      &trans  &trans  &trans  &kp GREATER_THAN  &kp RIGHT_BRACE    &kp RIGHT_PARENTHESIS  &kp MINUS       &kp EQUAL  &trans
&trans     &kp BACKSLASH    &trans       &trans                &kp LEFT_BRACKET  &trans                         &trans      &trans                  &trans            &kp RIGHT_BRACKET  &trans                 &trans          &trans     &trans
&trans     &trans           &trans       &trans                &trans                           &trans  &trans  &trans      &trans  &trans  &trans                    &trans             &trans                 &trans          &trans     &trans
            >;
        };

        Numbers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp N7  &kp N8  &kp N9   &kp PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6   &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &kp N1  &kp N2  &kp N3   &trans     &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &kp N0  &kp N0  &kp DOT  &trans     &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp F4   &kp F5   &kp F6   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans   &trans   &trans   &trans  &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans    &trans         &trans        &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans    &kp END        &kp HOME      &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp ESCAPE  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans    &kp PAGE_DOWN  &kp PAGE_UP   &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans            &trans         &trans        &trans     &trans      &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
